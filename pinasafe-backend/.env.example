SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EVIDENCE_STORAGE_BUCKET=your-private-evidence-bucket
AI_ENDPOINT_URL=https://your-allowlisted-classifier.example/predict
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

PORT=3000
# Use development only for local work; use production for deployed environments.
NODE_ENV=production
CORS_ORIGIN=http://localhost:8081

API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_MS=15min