SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

PORT=3000
# Use development only for local work; use production for deployed environments.
NODE_ENV=production
CORS_ORIGIN=http://localhost:8081

API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW_MS=15min